{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "CC7 coordinates map: Metrolink tram stops (DfT NaPTAN) on the boundaries of Greater Manchester's ten boroughs (ONS Open Geography Portal).",
  "title": {
    "text": "Metrolink tram stops in Greater Manchester",
    "subtitle": "Each dot is one stop, placed by latitude and longitude",
    "anchor": "start",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc7_gm_boroughs.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.LAD24NM",
            "type": "nominal",
            "title": "Borough"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc7_metrolink_stops.csv"
      },
      "mark": {
        "type": "circle",
        "size": 28,
        "color": "#f2a900",
        "stroke": "#5a4300",
        "strokeWidth": 0.6,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "stop",
            "type": "nominal",
            "title": "Metrolink stop"
          }
        ]
      }
    }
  ]
}