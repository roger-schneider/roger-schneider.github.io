{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "CC7 choropleth: median weekly pay of full-time workers (ASHE, by place of residence, latest year) in Greater Manchester's ten boroughs. Pay data joined to the boundaries with a lookup on the borough code.",
  "title": {
    "text": "Median weekly pay across Greater Manchester",
    "subtitle": "Full-time workers, gross, £, 2025, by borough of residence",
    "anchor": "start",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc7_gm_boroughs.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.LAD24CD",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc7_borough_pay.csv"
        },
        "key": "code",
        "fields": [
          "borough",
          "pay"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "!isValid(datum.pay)",
        "value": "#e3e3e3"
      },
      "field": "pay",
      "type": "quantitative",
      "title": "£ per week",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "orient": "right",
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "properties.LAD24NM",
        "type": "nominal",
        "title": "Borough"
      },
      {
        "field": "pay",
        "type": "quantitative",
        "title": "Median weekly pay (£)",
        "format": ",.0f"
      }
    ]
  }
}