{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "CC5 API chart: Rhine gauge readings (cm) at Kaub, Köln, Düsseldorf and Duisburg-Ruhrort, loaded live from the PEGELONLINE REST API (WSV). One API call per station; the radio buttons filter the last 7, 14 or ~31 days.",
  "title": {
    "text": "Rhine water levels at key gauges",
    "subtitle": "Gauge reading (Pegelstand), cm, 15-minute values",
    "anchor": "start",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#555555"
  },
  "width": "container",
  "height": 280,
  "background": "#ffffff",
  "view": {
    "stroke": null
  },
  "params": [
    {
      "name": "days",
      "value": 7,
      "bind": {
        "input": "radio",
        "options": [
          7,
          14,
          31
        ],
        "labels": [
          "Last 7 days",
          "Last 14 days",
          "Last month (max. available)"
        ],
        "name": "Time range: "
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "timestamp",
      "type": "temporal",
      "axis": {
        "title": "Source: PEGELONLINE, Wasserstraßen- und Schifffahrtsverwaltung des Bundes (live data)",
        "titleAnchor": "start",
        "titleFontWeight": "normal",
        "titleFontSize": 10,
        "titleColor": "#555555",
        "grid": false,
        "format": "%d %b"
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "Gauge reading (cm)",
        "grid": true,
        "gridColor": "#eeeeee"
      }
    },
    "color": {
      "field": "station",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Kaub",
          "Köln",
          "Düsseldorf",
          "Duisburg-Ruhrort"
        ],
        "range": [
          "#c1121f",
          "#1d3557",
          "#2a9d8f",
          "#e9a03b"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "station",
        "type": "nominal",
        "title": "Gauge"
      },
      {
        "field": "timestamp",
        "type": "temporal",
        "title": "Time",
        "format": "%d %b %Y, %H:%M"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Gauge reading (cm)"
      }
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://www.pegelonline.wsv.de/webservices/rest-api/v2/stations/KAUB/W/measurements.json?start=P31D",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "calculate": "'Kaub'",
          "as": "station"
        },
        {
          "filter": "time(datum.timestamp) >= now() - days * 24 * 60 * 60 * 1000"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://www.pegelonline.wsv.de/webservices/rest-api/v2/stations/K%C3%96LN/W/measurements.json?start=P31D",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "calculate": "'Köln'",
          "as": "station"
        },
        {
          "filter": "time(datum.timestamp) >= now() - days * 24 * 60 * 60 * 1000"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://www.pegelonline.wsv.de/webservices/rest-api/v2/stations/D%C3%9CSSELDORF/W/measurements.json?start=P31D",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "calculate": "'Düsseldorf'",
          "as": "station"
        },
        {
          "filter": "time(datum.timestamp) >= now() - days * 24 * 60 * 60 * 1000"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://www.pegelonline.wsv.de/webservices/rest-api/v2/stations/DUISBURG-RUHRORT/W/measurements.json?start=P31D",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "calculate": "'Duisburg-Ruhrort'",
          "as": "station"
        },
        {
          "filter": "time(datum.timestamp) >= now() - days * 24 * 60 * 60 * 1000"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    }
  ]
}