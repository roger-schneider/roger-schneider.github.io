{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "CC5 scraper chart: German inland waterway freight, scraped from de.wikipedia.org/wiki/Binnenschifffahrt. Performance values above 100 are divided by 10 because the scrape dropped the decimal comma (16,8 became 168). Correct values are all below 100, so they pass through unchanged.",
  "title": {
    "text": "Freight transport on Germany's inland waterways has been declining",
    "subtitle": "1950-2021, West Germany only until 1990",
    "anchor": "start",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#555555"
  },
  "width": "container",
  "height": 300,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "background": "#ffffff",
  "view": {"stroke": null},
  "data": {
    "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc5_wikitable.csv",
    "format": {"type": "csv", "parse": {"Year": "number", "Freight_Volume_Mio_t": "number", "Performance_Brd_tkm": "number"}}
  },
  "transform": [
    {"calculate": "datum.Performance_Brd_tkm > 100 ? datum.Performance_Brd_tkm / 10 : datum.Performance_Brd_tkm", "as": "performance"}
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {"domain": [1950, 2022], "nice": false},
      "axis": {
        "title": "Source: Destatis via German Wikipedia",
        "titleAnchor": "start",
        "titleFontWeight": "normal",
        "titleFontSize": 10,
        "titleColor": "#555555",
        "titlePadding": 10,
        "format": "d",
        "values": [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020],
        "labelOverlap": true,
        "grid": false
      }
    },
    "color": {
      "type": "nominal",
      "scale": {"domain": ["volume", "performance"], "range": ["#0e796c", "#e9a03b"]},
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "vertical",
        "symbolType": "stroke",
        "symbolStrokeWidth": 2,
        "labelFontSize": 10,
        "labelLimit": 400,
        "labelExpr": "datum.value === 'volume' ? 'Freight volume: weight of goods carried' : 'Performance: weight × distance travelled'"
      }
    }
  },
  "layer": [
    {
      "transform": [{"filter": "isValid(datum.Freight_Volume_Mio_t)"}],
      "mark": {"type": "line", "strokeWidth": 1, "point": {"size": 22}},
      "encoding": {
        "color": {"datum": "volume"},
        "y": {
          "field": "Freight_Volume_Mio_t",
          "type": "quantitative",
          "scale": {"domain": [0, 280]},
          "axis": {"title": "Freight volume (million tonnes)", "titleColor": "#0e796c", "orient": "left", "values": [0, 40, 80, 120, 160, 200, 240, 280], "grid": true, "gridColor": "#eeeeee"}
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "format": "d"},
          {"field": "Freight_Volume_Mio_t", "type": "quantitative", "title": "Million tonnes", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "isValid(datum.performance)"}],
      "mark": {"type": "line", "strokeWidth": 1, "point": {"size": 22}},
      "encoding": {
        "color": {"datum": "performance"},
        "y": {
          "field": "performance",
          "type": "quantitative",
          "scale": {"domain": [0, 70]},
          "axis": {"title": "Performance (billion tonne-km)", "titleColor": "#e9a03b", "orient": "right", "values": [0, 10, 20, 30, 40, 50, 60, 70], "grid": false}
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "format": "d"},
          {"field": "performance", "type": "quantitative", "title": "Billion tonne-km", "format": ".1f"}
        ]
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}}
}
