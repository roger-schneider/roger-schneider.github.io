{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "EU gas prices keep rising, making Germany's last-minute purchases painfully expensive",
    "anchor": "start",
    "subtitle": "Monthly, US$ per million BTU",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": 250,
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  "view": {"fill": "#ffffff", "strokeOpacity": 0},
  "data": {
    "url": "https://raw.githubusercontent.com/roger-schneider/roger-schneider.github.io/refs/heads/main/portfolio/data/clean/cc3_eu_gas_price.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "time(datum.date) >= utc(2025, 3, 1)"}
  ],
  "mark": {"type": "line", "color": "#000000", "strokeWidth": 1.5},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "timeUnit": "utcyearmonth",
      "bandPosition": 0.5,
      "scale": {"domain": [{"year": 2025, "month": 4, "date": 1, "utc": true}, {"year": 2026, "month": 12, "date": 1, "utc": true}]},
      "axis": {
        "title": "Source: IMF via FRED",
        "titleAnchor": "start",
        "titleFontWeight": "normal",
        "titleFontSize": 10,
        "titleColor": "#555555",
        "titlePadding": 10,
        "grid": false,
        "labelExpr": "utcFormat(datum.value, '%b %Y')",
        "tickCount": {"interval": "month", "step": 2},
        "labelAngle": -45
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "US$ per MMBtu", "grid": false}
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "timeUnit": "utcyearmonth", "title": "Month"},
      {"field": "value", "type": "quantitative", "title": "Price (US$/MMBtu)", "format": ".2f"}
    ]
  }
}